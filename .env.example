# Environment Variables — UGT VoiceCare
# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
#
# Every __PLACEHOLDER__ below is fake — see docs/admin-handoff.md for who
# provisions the real values and exactly which vars need them.

# ─── Database (MS SQL Server) ─────────────────────────────────────────────────
# Format: sqlserver://HOST:PORT;database=DB;user=USER;password=PASS;encrypt=true;trustServerCertificate=true
DATABASE_URL="sqlserver://__DB_HOST__:1433;database=UGT_VoiceCare;user=__DB_USER__;password=__DB_PASSWORD__;encrypt=true;trustServerCertificate=true"

# Shadow database — DEV ONLY, used by `prisma migrate dev` (never by
# `migrate deploy`). Needed because the app login on the shared org server has
# no CREATE DATABASE right, so Prisma cannot make one itself. Ask the DBA for an
# empty database on the dev server and point this at it — Prisma wipes it on
# every migrate dev, so it must never hold data. See references/migrations.md §1.1
# in the ugt-nextjs-database-setup skill, and docs/admin-handoff.md.
# Delete this line if the dev login may create databases itself.
SHADOW_DATABASE_URL="sqlserver://__DB_HOST__:1433;database=UGT_VoiceCare_Shadow;user=__DB_USER__;password=__DB_PASSWORD__;encrypt=true;trustServerCertificate=true"

# ─── AI (Google Gemini) ────────────────────────────────────────────────────────
# Required for the Gemini AI triage/clustering endpoints (src/app/api/ai/*).
# Without it, those routes fall back to static heuristics.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ─── Auth (Better Auth + Keycloak SSO) ─────────────────────────────────────────
# ugt-nextjs-auth-setup, 2026-09-02. SSO (Keycloak) only — no LDAP/local
# email-password in this project. See docs/admin-handoff.md §2 for the exact
# request sent to the Keycloak admin and which values come back.

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="__BETTER_AUTH_SECRET__"
# REQUIRED in every environment — bare origin only, NO path/basePath. Better
# Auth picks the __Secure- cookie prefix from this URL's scheme; an empty
# value in production causes a redirect loop (see docs/admin-handoff.md §2).
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# One shared org Keycloak server — this app has its own client in the org
# realm (Client ID = ugt-voicecare). See docs/admin-handoff.md §2.
KEYCLOAK_ISSUER="https://__KEYCLOAK_HOST__/realms/__REALM__"
KEYCLOAK_CLIENT_ID="ugt-voicecare"
KEYCLOAK_CLIENT_SECRET="__KEYCLOAK_CLIENT_SECRET__"

# Deployed standalone (no shared-domain basePath) as of this chunk — leave
# empty. See docs/admin-handoff.md §2 and .claude/state/handoff.md.
NEXT_PUBLIC_BASE_PATH=""
NEXT_PUBLIC_APP_NAME="UGT VoiceCare"

# ─── Misc ────────────────────────────────────────────────────────────────────
# The URL where this app is hosted (self-referential links, callbacks).
APP_URL="MY_APP_URL"

# Set to "1" to skip env validation (e.g. frontend-only CI that lacks secrets)
# SKIP_ENV_VALIDATION=1
