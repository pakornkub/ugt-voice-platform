# Environment Variables — UGT VoiceCare
# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
#
# Every __PLACEHOLDER__ below is fake — see docs/admin-handoff.md for who
# provisions the real values and exactly which vars need them.

# ─── Database (MS SQL Server) ─────────────────────────────────────────────────
# Format: sqlserver://HOST:PORT;database=DB;user=USER;password=PASS;encrypt=true;trustServerCertificate=true
# Local dev + `develop` deploy use UGT_VoicePlatform_DEV; prod (`main`) uses UGT_VoicePlatform.
DATABASE_URL="sqlserver://__DB_HOST__:1433;database=UGT_VoicePlatform_DEV;user=__DB_USER__;password=__DB_PASSWORD__;encrypt=true;trustServerCertificate=true"

# No shadow database: migrations are generated offline with `prisma migrate diff`
# and applied with `prisma migrate deploy` — `prisma migrate dev` is not used
# (see docs/project-context/decisions.md 2026-10-08). Uncomment only if you
# ever run `migrate dev` against a server where the login can't CREATE DATABASE.
# SHADOW_DATABASE_URL="sqlserver://__DB_HOST__:1433;database=UGT_VoicePlatform_Shadow;user=__DB_USER__;password=__DB_PASSWORD__;encrypt=true;trustServerCertificate=true"

# ─── AI (Google Gemini) ────────────────────────────────────────────────────────
# Required for the Gemini AI triage/clustering endpoints (src/app/api/ai/*).
# Without it, those routes fall back to static heuristics.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ─── Auth (Better Auth + Keycloak SSO) ─────────────────────────────────────────
# ugt-nextjs-auth-setup, 2026-09-02. SSO (Keycloak) only — no LDAP/local
# email-password in this project. See docs/admin-handoff.md §2 for the exact
# request sent to the Keycloak admin and which values come back.

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="__BETTER_AUTH_SECRET__"
# REQUIRED in every environment — bare origin only, NO path/basePath. Better
# Auth picks the __Secure- cookie prefix from this URL's scheme; an empty
# value in production causes a redirect loop (see docs/admin-handoff.md §2).
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# One shared org Keycloak server — this app has its own client in the org
# realm (Client ID = ugt-voice-platform). See docs/admin-handoff.md §2.
KEYCLOAK_ISSUER="https://__KEYCLOAK_HOST__/realms/__REALM__"
KEYCLOAK_CLIENT_ID="ugt-voice-platform"
KEYCLOAK_CLIENT_SECRET="__KEYCLOAK_CLIENT_SECRET__"

# Empty locally. Deployed: /ugt-voice-platform (prod) · /ugt-voice-platform-dev (dev)
# on https://ugtweb.ube.co.th — set by the Jenkinsfile as a build arg, not here.
NEXT_PUBLIC_BASE_PATH=""
NEXT_PUBLIC_APP_NAME="UGT VoiceCare"

# ─── SMTP (ugt-nextjs-mail-setup) ──────────────────────────────────────────────
# ugt-nextjs-mail-setup, 2026-09-02. Real workflow email for the notifications
# this app already generates (new ticket / status update / satisfaction
# survey / CEO alert / SLA warning). See docs/admin-handoff.md §3 for who
# provisions the real relay and which values come back.
#
# SMTP_HOST missing = lib/email.ts's sendMail() throws on purpose. Never let
# it default to localhost:25: mail disappears with no error and nobody
# notices for weeks.
SMTP_HOST="__SMTP_HOST__"
SMTP_PORT="25"
# true only for an implicit-TLS port (465). A relay on 25/587 with STARTTLS
# stays false — nodemailer upgrades by itself.
SMTP_SECURE="false"
# Leave both blank for an internal relay that accepts unauthenticated mail
# from inside the network (the common corporate case — same assumption as
# the placeholder host above until Admin/IT says otherwise).
SMTP_USER=""
SMTP_PASS=""
# Must be an address the relay is allowed to send AS, or it rejects the message.
SMTP_FROM="__SMTP_FROM__"

# ─── File storage + virus scanning (ugt-nextjs-upload-setup) ──────────────────
# ugt-nextjs-upload-setup, 2026-09-02. Real attachments for tickets (at
# submission) and timeline/inquiry notes — replaces EmployeeSubmitForm's old
# Math.random() fake-attachment simulator once the localStorage->Prisma
# call-site rewiring happens (not this chunk — see docs/project-context/decisions.md).
#
# Mount point of the Docker volume INSIDE the container. Must match the
# compose volume target and be writable by uid 1001 (the `nextjs` user in the
# image). Never point this at ./public — that would serve files without auth.
STORAGE_ROOT=/app/storage

# Largest file accepted, in bytes. 25 MB — matches EmployeeSubmitForm.tsx's
# existing attachment UI copy. Uploads go through a Route Handler, not a
# Server Action, so Next.js's 1 MB `serverActions.bodySizeLimit` does not
# apply — but a reverse proxy in front may have its own limit (nginx
# `client_max_body_size`), so raise both if/when one is confirmed in front of
# this app in production (see docs/admin-handoff.md §4).
UPLOAD_MAX_BYTES=26214400

# clamd, reachable on the compose network. THE CLAMAV SERVICE ITSELF IS NOT
# YET IN docker-compose.yml/docker-compose.dev.yml/Dockerfile — those files
# don't exist yet (ugt-nextjs-cicd-setup hasn't run). Apply
# assets/compose-and-dockerfile.snippet.md from the ugt-nextjs-upload-setup
# skill as a close-out step right after that chunk lands the Dockerfile — see
# .claude/state/handoff.md. The app FAILS CLOSED: if the scanner cannot be
# reached, uploads are refused rather than accepted unscanned.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# First start of the clamav container loads its signature database and can
# take several minutes — until then this timeout is what users hit.
CLAMAV_TIMEOUT_MS=30000

# ─── Misc ────────────────────────────────────────────────────────────────────
# Origin users open the app on — bare origin, NO basePath (same value as
# BETTER_AUTH_URL). Used for links in emails; deployed: https://ugtweb.ube.co.th
APP_URL="http://localhost:3000"

# Set to "1" to skip env validation (e.g. frontend-only CI that lacks secrets)
# SKIP_ENV_VALIDATION=1
